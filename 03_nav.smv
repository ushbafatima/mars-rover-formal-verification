-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 03_nav.smv
-- MODULE: NavModule
-- Owns: nav_state, obstacle_detected, path_found, terrain_mapped
-- Models: AutoNav / ENav FSM (Perseverance Enhanced Navigation)
--         Curiosity fault protection safe mode
--         All 5 blackout behavioural constraints from Section 3.3
-- Parameters: power_state, comm_state, pre_approved_loaded,
--             power_fault_active, post_blackout_hold — read only
-- =============================================================================

MODULE NavModule(power_state, comm_state, pre_approved_loaded, power_fault_active, post_blackout_hold)

VAR
  nav_state         : { IDLE, DRIVING, AUTONAV, OBSTACLE_DETECTED, REPLANNING, SAFE_MODE };
  obstacle_detected : boolean;  -- nondeterministic: stereo camera hazard flag
  path_found        : boolean;  -- nondeterministic: ENav path planner result
  terrain_mapped    : boolean;  -- TRUE when current terrain has been 3D-mapped

ASSIGN

  -- Initial state: parked, no hazards, terrain not yet mapped
  init(nav_state)         := IDLE;
  init(obstacle_detected) := FALSE;
  init(path_found)        := TRUE;
  init(terrain_mapped)    := FALSE;

  -- Navigation FSM transitions
  -- Encodes ALL constraints from Sections 3.2 and 3.3:
  --
  --   Section 3.2:
  --     [I1] CRITICAL power → cannot enter DRIVING or AUTONAV
  --     [I2] BLACKOUT + driving → only if pre_approved_loaded = TRUE
  --     [I3] AUTOMODE → immediately enter SAFE_MODE
  --
  --   Section 3.3 (blackout behavioural constraints):
  --     [B1] BLACKOUT: DRIVING only if pre_approved_loaded (I2 above)
  --     [B2] BLACKOUT: terrain_mapped must be TRUE before any drive step
  --     [B3] BLACKOUT + LOW power: REPLANNING blocked → SAFE_MODE instead
  --     [B4] BLACKOUT + anomaly (AUTOMODE): → SAFE_MODE (I3 above)
  --     [B5] Post-blackout: first step must be IDLE — enforced by post_blackout_hold flag
  --
  --   BUG FIX — power_fault_active (L1):
  --     [F1] power_fault_active=TRUE → IDLE cannot transition to DRIVING/AUTONAV
  --          until SAFE_MODE is reached first (satisfies L1's Until obligation)

  next(nav_state) :=
    case
      -- ── AUTOMODE OVERRIDE (Section 3.2 [I3], Section 3.3 [B4]) ──────────
      -- Highest priority: AUTOMODE forces SAFE_MODE regardless of nav state
      comm_state = AUTOMODE
        : SAFE_MODE;

      -- ── SAFE_MODE ─────────────────────────────────────────────────────────
      -- Exit safe mode only when: power fully recovered (NOMINAL = fault cleared),
      -- not in blackout or automode.
      -- NOTE: power_state = NOMINAL is semantically equivalent to !power_fault_active
      --       (power_fault_active is TRUE iff power_state != NOMINAL per PowerModule).
      nav_state = SAFE_MODE & power_state = NOMINAL & comm_state != BLACKOUT
        & comm_state != AUTOMODE
        : IDLE;
      nav_state = SAFE_MODE
        : SAFE_MODE;

      -- ── IDLE ──────────────────────────────────────────────────────────────

      -- [B5] Post-blackout hold: first step after blackout must stay IDLE.
      -- post_blackout_hold is TRUE exactly on the one step when BLACKOUT just ended.
      -- This is the structural enforcement that makes L5 hold.
      nav_state = IDLE & post_blackout_hold
        : IDLE;

      -- Cannot drive: critical power (C1 / [I1])
      nav_state = IDLE & power_state = CRITICAL
        : IDLE;

      -- [FIX — L1] Cannot start driving when power fault is active (power=LOW or CRITICAL).
      -- L1 requires: fault_active → !DRIVING U SAFE_MODE.
      -- Rover must pass through SAFE_MODE before driving is permitted again.
      -- Without this block, IDLE→DRIVING was possible while fault_active=TRUE, falsifying L1.
      nav_state = IDLE & power_fault_active
        : IDLE;

      -- Cannot drive: in BLACKOUT without pre-approval or terrain not mapped
      nav_state = IDLE & comm_state = BLACKOUT
        & (!pre_approved_loaded | !terrain_mapped)
        : IDLE;

      -- Normal idle → can start driving or autonav (terrain must be mapped)
      -- terrain_mapped is set to TRUE during IDLE (mapping phase before drive)
      nav_state = IDLE & power_state != CRITICAL & !power_fault_active
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & terrain_mapped
        : { DRIVING, AUTONAV };

      -- Idle with terrain not yet mapped: stay idle and map
      nav_state = IDLE & power_state != CRITICAL & !power_fault_active
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & !terrain_mapped
        : IDLE;

      -- BLACKOUT + pre-approved + terrain mapped → can drive on pre-loaded plan only
      nav_state = IDLE & comm_state = BLACKOUT
        & pre_approved_loaded & terrain_mapped
        & power_state != CRITICAL & !power_fault_active
        : { IDLE, DRIVING };

      -- ── DRIVING ───────────────────────────────────────────────────────────
      -- Obstacle encountered (nondeterministic) → OBSTACLE_DETECTED
      nav_state = DRIVING & obstacle_detected
        : OBSTACLE_DETECTED;

      -- Critical power while driving → SAFE_MODE immediately
      nav_state = DRIVING & power_state = CRITICAL
        : SAFE_MODE;

      -- AUTOMODE during drive → already handled by top priority case above

      -- Blackout: driving with pre-approval and terrain mapped → continue or finish
      nav_state = DRIVING & comm_state = BLACKOUT & pre_approved_loaded & terrain_mapped
        & power_state != CRITICAL & !obstacle_detected
        : { DRIVING, IDLE };

      -- Blackout: driving but pre-approval or terrain condition violated → SAFE_MODE
      nav_state = DRIVING & comm_state = BLACKOUT
        & (!pre_approved_loaded | !terrain_mapped)
        : SAFE_MODE;

      -- Normal driving: can continue or finish (go IDLE)
      nav_state = DRIVING & comm_state != BLACKOUT & comm_state != AUTOMODE
        & power_state != CRITICAL & !obstacle_detected
        : { DRIVING, IDLE };

      -- ── AUTONAV ───────────────────────────────────────────────────────────
      -- ENav "thinking while driving" mode — more autonomous than DRIVING
      -- Same constraints as DRIVING but restricted during BLACKOUT (no new exploration)
      nav_state = AUTONAV & obstacle_detected
        : OBSTACLE_DETECTED;

      nav_state = AUTONAV & power_state = CRITICAL
        : SAFE_MODE;

      -- AUTONAV blocked during BLACKOUT: Section 3.3 [B2] no new terrain exploration
      nav_state = AUTONAV & comm_state = BLACKOUT
        : SAFE_MODE;

      nav_state = AUTONAV & comm_state != BLACKOUT & comm_state != AUTOMODE
        & power_state != CRITICAL & !obstacle_detected
        : { AUTONAV, IDLE };

      -- ── OBSTACLE_DETECTED ─────────────────────────────────────────────────
      -- ENav two-stage: always proceeds to REPLANNING or SAFE_MODE (never stuck)
      -- Section 3.3 [B3]: BLACKOUT + LOW power → REPLANNING blocked → SAFE_MODE
      nav_state = OBSTACLE_DETECTED & comm_state = BLACKOUT & power_state = LOW
        : SAFE_MODE;

      nav_state = OBSTACLE_DETECTED & power_state = CRITICAL
        : SAFE_MODE;

      nav_state = OBSTACLE_DETECTED & comm_state = AUTOMODE
        : SAFE_MODE;

      -- Normal: proceed to replanning
      nav_state = OBSTACLE_DETECTED
        : REPLANNING;

      -- ── REPLANNING ────────────────────────────────────────────────────────
      -- ENav path planner result is nondeterministic (path_found: TRUE/FALSE)
      -- If path found → resume drive; if not → SAFE_MODE
      -- Section 3.3 [B3]: BLACKOUT + LOW power → SAFE_MODE (no replanning)
      nav_state = REPLANNING & power_state = CRITICAL
        : SAFE_MODE;

      nav_state = REPLANNING & comm_state = AUTOMODE
        : SAFE_MODE;

      -- Path found → resume appropriate drive mode
      nav_state = REPLANNING & path_found & power_state != CRITICAL
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        : { DRIVING, AUTONAV };

      -- Path not found → safe mode
      nav_state = REPLANNING & !path_found
        : SAFE_MODE;

      -- BLACKOUT during replanning: only continue if pre-approved and non-critical power
      nav_state = REPLANNING & comm_state = BLACKOUT
        & pre_approved_loaded & power_state != CRITICAL & path_found
        : { DRIVING, SAFE_MODE };

      nav_state = REPLANNING & comm_state = BLACKOUT
        & (!pre_approved_loaded | power_state = LOW)
        : SAFE_MODE;

      TRUE : nav_state;
    esac;

  -- obstacle_detected: nondeterministic hazard flag (stereo camera)
  -- Can appear during DRIVING or AUTONAV; clears when not moving
  next(obstacle_detected) :=
    case
      nav_state = DRIVING | nav_state = AUTONAV : { TRUE, FALSE };
      TRUE                                       : FALSE;
    esac;

  -- path_found: ENav path planner result — nondeterministic
  -- Only meaningful when in REPLANNING; nondeterministic elsewhere
  next(path_found) :=
    case
      nav_state = REPLANNING : { TRUE, FALSE };
      TRUE                   : { TRUE, FALSE };
    esac;

  -- terrain_mapped: becomes TRUE during IDLE (mapping phase)
  -- Persists as TRUE once mapped (ENav continuously updates)
  -- Resets to FALSE after SAFE_MODE (terrain re-verification required)
  next(terrain_mapped) :=
    case
      nav_state = IDLE & power_state != CRITICAL : TRUE;   -- mapping during idle
      nav_state = SAFE_MODE                      : FALSE;  -- reset after fault
      TRUE                                       : terrain_mapped;
    esac;

-- Fairness constraints:
-- Without these, NuSMV could find infinite paths where the system
-- stays in OBSTACLE_DETECTED or REPLANNING forever (violating C3 liveness).
-- These fairness constraints say: the system must not perpetually avoid progress.
FAIRNESS nav_state != OBSTACLE_DETECTED
FAIRNESS nav_state != REPLANNING
FAIRNESS !(power_state = CRITICAL & comm_state = BLACKOUT)
