-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 03_nav.smv
-- MODULE: NavModule
-- =============================================================================

MODULE NavModule(power_state, comm_state, pre_approved_loaded, power_fault_active, post_blackout_hold)

VAR
  nav_state         : { IDLE, DRIVING, AUTONAV, OBSTACLE_DETECTED, REPLANNING, SAFE_MODE };
  obstacle_detected : boolean;
  path_found        : boolean;
  terrain_mapped    : boolean;

ASSIGN

  init(nav_state)         := IDLE;
  init(obstacle_detected) := FALSE;
  init(path_found)        := TRUE;
  init(terrain_mapped)    := FALSE;

  next(nav_state) :=
    case
      -- ── PRIORITY 1: AUTOMODE forces SAFE_MODE ────────────────────────────
      comm_state = AUTOMODE
        : SAFE_MODE;

      -- ── PRIORITY 2: SAFE_MODE ─────────────────────────────────────────────
      nav_state = SAFE_MODE & power_state = NOMINAL & comm_state != BLACKOUT
        & comm_state != AUTOMODE
        : IDLE;
      nav_state = SAFE_MODE
        : SAFE_MODE;

      -- ── PRIORITY 3: OBSTACLE_DETECTED (must resolve before any override) ──
      -- [C3a] OBSTACLE_DETECTED must always go to REPLANNING or SAFE_MODE.
      -- post_blackout_hold must NOT override this — C3a takes priority.
      nav_state = OBSTACLE_DETECTED & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      nav_state = OBSTACLE_DETECTED & comm_state = BLACKOUT & power_state = LOW
        : SAFE_MODE;
      nav_state = OBSTACLE_DETECTED & comm_state = AUTOMODE
        : SAFE_MODE;
      nav_state = OBSTACLE_DETECTED
        : REPLANNING;

      -- ── PRIORITY 4: REPLANNING (must resolve before any override) ─────────
      -- [C3b] REPLANNING must always go to DRIVING, AUTONAV, or SAFE_MODE.
      -- post_blackout_hold must NOT override this — C3b takes priority.
      nav_state = REPLANNING & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      nav_state = REPLANNING & comm_state = AUTOMODE
        : SAFE_MODE;
      nav_state = REPLANNING & path_found & power_state != CRITICAL
        & !power_fault_active
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        : { DRIVING, AUTONAV };
      nav_state = REPLANNING & !path_found
        : SAFE_MODE;
      nav_state = REPLANNING & comm_state = BLACKOUT
        & pre_approved_loaded & power_state != CRITICAL & !power_fault_active & path_found
        : { DRIVING, SAFE_MODE };
      nav_state = REPLANNING & comm_state = BLACKOUT
        & (!pre_approved_loaded | power_state = LOW | power_fault_active)
        : SAFE_MODE;

      -- ── PRIORITY 5: POST-BLACKOUT HOLD [B5, F-L5] ─────────────────────────
      -- Only applies to IDLE, DRIVING, AUTONAV — never overrides OBSTACLE/REPLANNING.
      -- Forces IDLE at the first step after blackout ends.
      post_blackout_hold
        : IDLE;

      -- ── IDLE ──────────────────────────────────────────────────────────────

      -- [F-L1] Power fault in IDLE → SAFE_MODE (not just stay IDLE).
      -- Until requires SAFE_MODE to be reached, not just avoided-DRIVING.
      nav_state = IDLE & power_fault_active
        : SAFE_MODE;

      -- [C1] Critical power → SAFE_MODE
      nav_state = IDLE & power_state = CRITICAL
        : SAFE_MODE;

      -- Cannot drive in BLACKOUT without pre-approval or terrain [B1, B2]
      nav_state = IDLE & comm_state = BLACKOUT
        & (!pre_approved_loaded | !terrain_mapped)
        : IDLE;

      -- BLACKOUT + all conditions met → limited drive
      nav_state = IDLE & comm_state = BLACKOUT
        & pre_approved_loaded & terrain_mapped
        & power_state != CRITICAL & !power_fault_active
        : { IDLE, DRIVING };

      -- Normal healthy idle → drive or autonav
      nav_state = IDLE & power_state != CRITICAL & !power_fault_active
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & terrain_mapped
        : { DRIVING, AUTONAV };

      -- Terrain not yet mapped
      nav_state = IDLE & power_state != CRITICAL & !power_fault_active
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & !terrain_mapped
        : IDLE;

      -- ── DRIVING ───────────────────────────────────────────────────────────

      nav_state = DRIVING & obstacle_detected
        : OBSTACLE_DETECTED;

      -- [F-C1, F-L1] Any power fault while driving → SAFE_MODE
      nav_state = DRIVING & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;

      nav_state = DRIVING & comm_state = BLACKOUT & pre_approved_loaded & terrain_mapped
        & power_state != CRITICAL & !power_fault_active & !obstacle_detected
        : { DRIVING, IDLE };

      nav_state = DRIVING & comm_state = BLACKOUT
        & (!pre_approved_loaded | !terrain_mapped)
        : SAFE_MODE;

      nav_state = DRIVING & comm_state != BLACKOUT & comm_state != AUTOMODE
        & power_state != CRITICAL & !power_fault_active & !obstacle_detected
        : { DRIVING, IDLE };

      -- ── AUTONAV ───────────────────────────────────────────────────────────

      nav_state = AUTONAV & obstacle_detected
        : OBSTACLE_DETECTED;

      nav_state = AUTONAV & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;

      nav_state = AUTONAV & comm_state = BLACKOUT
        : SAFE_MODE;

      nav_state = AUTONAV & comm_state != BLACKOUT & comm_state != AUTOMODE
        & power_state != CRITICAL & !power_fault_active & !obstacle_detected
        : { AUTONAV, IDLE };

      TRUE : nav_state;
    esac;

  next(obstacle_detected) :=
    case
      nav_state = DRIVING | nav_state = AUTONAV : { TRUE, FALSE };
      TRUE                                       : FALSE;
    esac;

  next(path_found) :=
    case
      nav_state = REPLANNING : { TRUE, FALSE };
      TRUE                   : { TRUE, FALSE };
    esac;

  next(terrain_mapped) :=
    case
      nav_state = IDLE & power_state != CRITICAL : TRUE;
      nav_state = SAFE_MODE                      : FALSE;
      TRUE                                       : terrain_mapped;
    esac;

FAIRNESS nav_state != OBSTACLE_DETECTED
FAIRNESS nav_state != REPLANNING
FAIRNESS !(power_state = CRITICAL & comm_state = BLACKOUT)
