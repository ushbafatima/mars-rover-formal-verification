-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 03_nav.smv
-- MODULE: NavModule
-- =============================================================================

MODULE NavModule(power_state, comm_state, pre_approved_loaded, power_fault_active, post_blackout_hold, blackout_exit_pending)

VAR
  nav_state         : { IDLE, DRIVING, AUTONAV, OBSTACLE_DETECTED, REPLANNING, SAFE_MODE };
  obstacle_detected : boolean;
  path_found        : boolean;
  terrain_mapped    : boolean;
  -- [FIX-L1] fault_latch: latches TRUE when power_fault_active fires, clears only when
  -- SAFE_MODE is entered. Prevents IDLE->DRIVING after a fault without SAFE_MODE checkpoint.
  fault_latch       : boolean;

ASSIGN

  init(nav_state)         := IDLE;
  init(obstacle_detected) := FALSE;
  init(path_found)        := TRUE;
  init(terrain_mapped)    := FALSE;
  init(fault_latch)       := FALSE;

  next(nav_state) :=
    case
      -- ── PRIORITY 1: AUTOMODE forces SAFE_MODE ─────────────────────────────
      comm_state = AUTOMODE
        : SAFE_MODE;

      -- ── PRIORITY 2: SAFE_MODE ─────────────────────────────────────────────
      -- [FIX-L5] During BLACKOUT, SAFE_MODE must exit to IDLE (not stay stuck in
      -- SAFE_MODE). This ensures that on the last BLACKOUT step, if nav=SAFE_MODE,
      -- next(nav)=IDLE as L5 requires. CRITICAL power keeps rover in SAFE_MODE.
      nav_state = SAFE_MODE & comm_state = BLACKOUT & power_state != CRITICAL
        : IDLE;
      nav_state = SAFE_MODE & post_blackout_hold
        & comm_state != AUTOMODE & comm_state != BLACKOUT
        : IDLE;
      nav_state = SAFE_MODE & power_state = NOMINAL & comm_state != BLACKOUT
        & comm_state != AUTOMODE
        : IDLE;
      nav_state = SAFE_MODE
        : SAFE_MODE;

      -- ── PRIORITY 3: OBSTACLE_DETECTED ─────────────────────────────────────
      nav_state = OBSTACLE_DETECTED & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      nav_state = OBSTACLE_DETECTED & comm_state = AUTOMODE
        : SAFE_MODE;
      nav_state = OBSTACLE_DETECTED
        : REPLANNING;

      -- ── PRIORITY 4: REPLANNING ─────────────────────────────────────────────
      nav_state = REPLANNING & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      nav_state = REPLANNING & comm_state = AUTOMODE
        : SAFE_MODE;
      nav_state = REPLANNING & path_found & power_state != CRITICAL
        & !power_fault_active
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        : { DRIVING, AUTONAV };
      nav_state = REPLANNING & !path_found
        : SAFE_MODE;
      -- [FIX-L5] During BLACKOUT, replanning cannot resume DRIVING — go SAFE_MODE
      -- then SAFE_MODE&BLACKOUT->IDLE (P2 above). Driving resumes after blackout ends.
      nav_state = REPLANNING & comm_state = BLACKOUT
        : SAFE_MODE;

      -- ── PRIORITY 5: POST-BLACKOUT HOLD [L5] ───────────────────────────────
      -- bep fires at the DEGRADED step (one step after blackout exits). By then,
      -- nav is already IDLE (because BLACKOUT forces all states to IDLE — see P2,P7,P8).
      -- This priority handles the edge case where nav enters a non-IDLE state via
      -- a same-step nondeterministic transition at the DEGRADED boundary.
      blackout_exit_pending
        & power_state != CRITICAL
        & comm_state != AUTOMODE
        & nav_state != SAFE_MODE
        & nav_state != OBSTACLE_DETECTED
        & nav_state != REPLANNING
        : IDLE;

      -- ── PRIORITY 6: IDLE ───────────────────────────────────────────────────
      -- [FIX-L1] fault_latch: if a fault was seen without SAFE_MODE being visited,
      -- force SAFE_MODE from IDLE so the Until obligation is discharged.
      nav_state = IDLE & fault_latch
        : SAFE_MODE;
      nav_state = IDLE & power_fault_active
        : SAFE_MODE;
      nav_state = IDLE & power_state = CRITICAL
        : SAFE_MODE;
      -- [FIX-L5] During BLACKOUT, IDLE always stays IDLE — never goes to DRIVING.
      -- This prevents IDLE->DRIVING on the last BLACKOUT step which would put
      -- DRIVING at the first post-BLACKOUT step, violating L5.
      nav_state = IDLE & comm_state = BLACKOUT
        : IDLE;
      -- [FIX-L1] Guard IDLE->DRIVING/AUTONAV with !fault_latch to ensure SAFE_MODE
      -- is visited before driving resumes after any power fault.
      nav_state = IDLE & power_state != CRITICAL & !power_fault_active
        & !fault_latch
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & terrain_mapped
        : { DRIVING, AUTONAV };
      nav_state = IDLE & power_state != CRITICAL & !power_fault_active
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & !terrain_mapped
        : IDLE;

      -- ── PRIORITY 7: DRIVING ───────────────────────────────────────────────
      nav_state = DRIVING & power_state = CRITICAL
        : SAFE_MODE;
      -- [FIX-L5] During BLACKOUT, DRIVING always goes to IDLE regardless of fault.
      -- If fault is also active: IDLE & fault_latch → SAFE_MODE next step (P6).
      -- This ensures next(nav)=IDLE on any BLACKOUT step, satisfying L5.
      nav_state = DRIVING & comm_state = BLACKOUT
        : IDLE;
      nav_state = DRIVING & power_fault_active
        : SAFE_MODE;
      nav_state = DRIVING & obstacle_detected
        : OBSTACLE_DETECTED;
      nav_state = DRIVING & comm_state != BLACKOUT & comm_state != AUTOMODE
        & power_state != CRITICAL & !power_fault_active & !obstacle_detected
        : { DRIVING, IDLE };

      -- ── PRIORITY 8: AUTONAV ───────────────────────────────────────────────
      nav_state = AUTONAV & power_state = CRITICAL
        : SAFE_MODE;
      -- [FIX-L5] AUTONAV during BLACKOUT goes to IDLE (was SAFE_MODE).
      -- SAFE_MODE at a BLACKOUT step would then exit to IDLE (P2), but that's
      -- one step too late for L5. Going directly to IDLE is correct.
      nav_state = AUTONAV & comm_state = BLACKOUT
        : IDLE;
      nav_state = AUTONAV & power_fault_active
        : SAFE_MODE;
      nav_state = AUTONAV & obstacle_detected
        : OBSTACLE_DETECTED;
      nav_state = AUTONAV & comm_state != BLACKOUT & comm_state != AUTOMODE
        & power_state != CRITICAL & !power_fault_active & !obstacle_detected
        : { AUTONAV, IDLE };

      TRUE : nav_state;
    esac;

  -- [FIX-L1] fault_latch latches TRUE when power_fault_active is seen.
  -- Cleared only when SAFE_MODE is entered (next_nav_state = SAFE_MODE).
  -- This ensures the Until in L1 is always discharged via SAFE_MODE before
  -- the rover is allowed back into DRIVING or AUTONAV.
  next(fault_latch) :=
    case
      next(nav_state) = SAFE_MODE : FALSE;
      power_fault_active          : TRUE;
      fault_latch                 : TRUE;
      TRUE                        : FALSE;
    esac;

  next(obstacle_detected) :=
    case
      nav_state = DRIVING | nav_state = AUTONAV : { TRUE, FALSE };
      TRUE                                       : FALSE;
    esac;

  next(path_found) :=
    case
      nav_state = REPLANNING : { TRUE, FALSE };
      TRUE                   : { TRUE, FALSE };
    esac;

  next(terrain_mapped) :=
    case
      nav_state = IDLE & power_state != CRITICAL : TRUE;
      nav_state = SAFE_MODE                      : FALSE;
      TRUE                                       : terrain_mapped;
    esac;

FAIRNESS nav_state != OBSTACLE_DETECTED
FAIRNESS nav_state != REPLANNING
FAIRNESS !(power_state = CRITICAL & comm_state = BLACKOUT)