-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FAULTY MODEL B — LTL Counterexample Demonstration
-- Demonstrates violation of L1: Safe Mode Must Precede Drive Resumption
--
-- BUG: OBSTACLE_DETECTED skips straight to DRIVING instead of REPLANNING.
-- When power_fault_active=TRUE, rover drives without visiting SAFE_MODE,
-- violating L1's Until obligation: fault_active -> !DRIVING U SAFE_MODE
--
-- Expected output:
--   C1 → true  (power guard covers all states)
--   L1 → false (lasso counterexample, look for "-- Loop starts here --")
-- =============================================================================

MODULE PowerModule

VAR
  power_state        : { NOMINAL, LOW, CRITICAL };
  power_fault_active : boolean;

ASSIGN
  init(power_state)        := NOMINAL;
  init(power_fault_active) := FALSE;

  next(power_state) :=
    case
      power_state = NOMINAL  : { NOMINAL, LOW };
      power_state = LOW      : { LOW, CRITICAL, NOMINAL };
      power_state = CRITICAL : { CRITICAL, LOW };
    esac;

  next(power_fault_active) :=
    case
      next(power_state) = NOMINAL  : FALSE;
      next(power_state) = LOW      : TRUE;
      next(power_state) = CRITICAL : TRUE;
    esac;

FAIRNESS power_state != CRITICAL


-- =============================================================================
MODULE CommModule(power_state)

VAR
  comm_state          : { CONNECTED, DEGRADED, BLACKOUT, AUTOMODE };
  pre_approved_loaded : boolean;
  blackout_steps      : 0..20;

ASSIGN
  init(comm_state)          := CONNECTED;
  init(pre_approved_loaded) := FALSE;
  init(blackout_steps)      := 0;

  next(comm_state) :=
    case
      comm_state = CONNECTED & power_state = CRITICAL          : AUTOMODE;
      comm_state = CONNECTED & power_state != CRITICAL         : { CONNECTED, DEGRADED };
      comm_state = DEGRADED  & power_state = CRITICAL          : AUTOMODE;
      comm_state = DEGRADED  & power_state != CRITICAL         : { DEGRADED, BLACKOUT, CONNECTED };
      comm_state = BLACKOUT  & blackout_steps >= 18            : DEGRADED;
      comm_state = BLACKOUT  & blackout_steps < 18             : BLACKOUT;
      comm_state = AUTOMODE  & power_state != CRITICAL         : { AUTOMODE, DEGRADED };
      comm_state = AUTOMODE  & power_state = CRITICAL          : AUTOMODE;
      TRUE                                                     : comm_state;
    esac;

  next(pre_approved_loaded) :=
    case
      comm_state = CONNECTED                               : { TRUE, FALSE };
      comm_state = DEGRADED & next(comm_state) = BLACKOUT  : TRUE;
      comm_state = DEGRADED & next(comm_state) != BLACKOUT : { TRUE, FALSE };
      comm_state = BLACKOUT                                : pre_approved_loaded;
      comm_state = AUTOMODE & next(comm_state) = DEGRADED  : FALSE;
      TRUE                                                 : pre_approved_loaded;
    esac;

  next(blackout_steps) :=
    case
      next(comm_state) = BLACKOUT & blackout_steps < 20 : blackout_steps + 1;
      next(comm_state) != BLACKOUT                      : 0;
      TRUE                                              : blackout_steps;
    esac;

FAIRNESS comm_state != BLACKOUT
FAIRNESS comm_state != AUTOMODE


-- =============================================================================
-- FAULTY NavModule
-- BUG: OBSTACLE_DETECTED -> DRIVING directly when power_fault_active
-- Extra guard added: next(power_state) != CRITICAL ensures C1 still passes
-- =============================================================================
MODULE NavModule(power_state, comm_state, pre_approved_loaded, power_fault_active)

VAR
  nav_state         : { IDLE, DRIVING, AUTONAV, OBSTACLE_DETECTED, REPLANNING, SAFE_MODE };
  obstacle_detected : boolean;
  path_found        : boolean;
  terrain_mapped    : boolean;
  fault_latch       : boolean;

ASSIGN
  init(nav_state)         := IDLE;
  init(obstacle_detected) := FALSE;
  init(path_found)        := TRUE;
  init(terrain_mapped)    := FALSE;
  init(fault_latch)       := FALSE;

  next(nav_state) :=
    case
      -- AUTOMODE override — highest priority
      comm_state = AUTOMODE
        : SAFE_MODE;

      -- Power guard intact on ALL states — C1 must pass
      power_state = CRITICAL
        : SAFE_MODE;

      -- SAFE_MODE exits
      nav_state = SAFE_MODE & !fault_latch
        & power_state != CRITICAL
        & comm_state != AUTOMODE & comm_state != BLACKOUT
        : IDLE;
      nav_state = SAFE_MODE
        : SAFE_MODE;

      -- *** BUG IS HERE ***
      -- CORRECT would send fault_active obstacles to SAFE_MODE first:
      --   nav_state = OBSTACLE_DETECTED & power_fault_active : SAFE_MODE;
      --   nav_state = OBSTACLE_DETECTED : REPLANNING;
      -- FAULTY: jumps straight to DRIVING when fault active
      -- next(power_state) != CRITICAL guard keeps C1 passing
      nav_state = OBSTACLE_DETECTED & power_state = CRITICAL
        : SAFE_MODE;
      nav_state = OBSTACLE_DETECTED & next(power_state) = CRITICAL
        : SAFE_MODE;
      nav_state = OBSTACLE_DETECTED & comm_state = BLACKOUT
        : SAFE_MODE;
      nav_state = OBSTACLE_DETECTED & power_fault_active
        & next(power_state) != CRITICAL
        : DRIVING;   -- BUG: should be SAFE_MODE, goes to DRIVING instead
      nav_state = OBSTACLE_DETECTED
        : REPLANNING;

      -- REPLANNING (correct)
      nav_state = REPLANNING & power_state = CRITICAL
        : SAFE_MODE;
      nav_state = REPLANNING & power_fault_active
        : SAFE_MODE;
      nav_state = REPLANNING & comm_state = BLACKOUT
        : SAFE_MODE;
      nav_state = REPLANNING & path_found
        & power_state != CRITICAL & !power_fault_active & !fault_latch
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        : { DRIVING, AUTONAV };
      nav_state = REPLANNING
        : SAFE_MODE;

      -- IDLE (correct — full power guard in place)
      nav_state = IDLE & (fault_latch | power_fault_active | power_state = CRITICAL)
        : SAFE_MODE;
      nav_state = IDLE & comm_state = BLACKOUT
        : IDLE;
      nav_state = IDLE & !fault_latch & !power_fault_active
        & power_state != CRITICAL
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & terrain_mapped
        : { DRIVING, AUTONAV };
      nav_state = IDLE
        : IDLE;

      -- DRIVING (correct)
      nav_state = DRIVING & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      nav_state = DRIVING & comm_state = BLACKOUT
        : IDLE;
      nav_state = DRIVING & obstacle_detected
        : OBSTACLE_DETECTED;
      nav_state = DRIVING
        : { DRIVING, IDLE };

      -- AUTONAV (correct)
      nav_state = AUTONAV & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      nav_state = AUTONAV & comm_state = BLACKOUT
        : IDLE;
      nav_state = AUTONAV & obstacle_detected
        : OBSTACLE_DETECTED;
      nav_state = AUTONAV
        : { AUTONAV, IDLE };

      TRUE : nav_state;
    esac;

  next(fault_latch) :=
    case
      next(nav_state) = SAFE_MODE : FALSE;
      power_fault_active          : TRUE;
      fault_latch                 : TRUE;
      TRUE                        : FALSE;
    esac;

  next(obstacle_detected) :=
    case
      nav_state = DRIVING | nav_state = AUTONAV : { TRUE, FALSE };
      TRUE                                       : FALSE;
    esac;

  next(path_found) := { TRUE, FALSE };

  next(terrain_mapped) :=
    case
      nav_state = IDLE & power_state != CRITICAL
        & comm_state != BLACKOUT & comm_state != AUTOMODE : TRUE;
      nav_state = SAFE_MODE                               : FALSE;
      TRUE                                                : terrain_mapped;
    esac;

FAIRNESS nav_state != OBSTACLE_DETECTED
FAIRNESS nav_state != REPLANNING
FAIRNESS !(power_state = CRITICAL & comm_state = BLACKOUT)


-- =============================================================================
MODULE main

VAR
  power : PowerModule;
  comm  : CommModule(power.power_state);
  nav   : NavModule(power.power_state, comm.comm_state,
                    comm.pre_approved_loaded, power.power_fault_active);

-- C1: MUST PASS — power guard covers all states
SPEC AG(
  power.power_state = CRITICAL ->
  nav.nav_state != DRIVING & nav.nav_state != AUTONAV
)

-- L1: WILL FAIL — lasso counterexample
-- Once fault is active, rover must not drive until SAFE_MODE is reached
-- Bug: OBSTACLE_DETECTED -> DRIVING with fault active, SAFE_MODE never visited first
LTLSPEC G(
  power.power_fault_active ->
  (nav.nav_state != DRIVING) U (nav.nav_state = SAFE_MODE)
)