-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 02_comm.smv
-- MODULE: CommModule
-- Parameters: power_state, power_fault_active
-- =============================================================================

MODULE CommModule(power_state, power_fault_active)

VAR
  comm_state          : { CONNECTED, DEGRADED, BLACKOUT, AUTOMODE };
  pre_approved_loaded : boolean;
  blackout_steps      : 0..20;

ASSIGN

  init(comm_state)          := CONNECTED;
  init(pre_approved_loaded) := TRUE;
  init(blackout_steps)      := 0;

  next(comm_state) :=
    case
      comm_state = CONNECTED & power_state = CRITICAL  : AUTOMODE;
      comm_state = CONNECTED & power_state != CRITICAL : { CONNECTED, DEGRADED };

      comm_state = DEGRADED  & power_state = CRITICAL  : AUTOMODE;
      comm_state = DEGRADED  & power_state != CRITICAL : { DEGRADED, BLACKOUT, CONNECTED };

      -- [L5 FIX] Blackout exits at >= 18 steps (not >= 13).
      -- This gives a deterministic exit point so the nav module can reliably
      -- detect "last blackout step" via blackout_steps = 18 and force IDLE.
      comm_state = BLACKOUT  & blackout_steps >= 18    : DEGRADED;
      comm_state = BLACKOUT  & blackout_steps < 18     : BLACKOUT;

      comm_state = AUTOMODE  & power_state != CRITICAL : { AUTOMODE, DEGRADED };
      comm_state = AUTOMODE  & power_state = CRITICAL  : AUTOMODE;

      TRUE : comm_state;
    esac;

  -- pre_approved_loaded: TRUE whenever in CONNECTED, DEGRADED, or BLACKOUT.
  -- Stays as-is in AUTOMODE self-loop. Forced TRUE when next step is BLACKOUT.
  next(pre_approved_loaded) :=
    case
      next(comm_state) = BLACKOUT : TRUE;
      comm_state = BLACKOUT       : TRUE;
      comm_state = DEGRADED       : TRUE;
      comm_state = CONNECTED      : TRUE;
      comm_state = AUTOMODE       : pre_approved_loaded;
      TRUE                        : pre_approved_loaded;
    esac;

  next(blackout_steps) :=
    case
      next(comm_state) = BLACKOUT & blackout_steps < 20 : blackout_steps + 1;
      next(comm_state) != BLACKOUT                      : 0;
      TRUE                                              : blackout_steps;
    esac;

FAIRNESS comm_state != BLACKOUT
FAIRNESS comm_state != AUTOMODE
