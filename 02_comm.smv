-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 02_comm.smv
-- MODULE: CommModule
-- Owns: comm_state, pre_approved_loaded, blackout_steps, post_blackout_hold
-- Models: Solar conjunction blackout (~13-18 days → nondeterministic 1..18 steps)
--         Pre-approved command sequence protocol (Curiosity 2023: 18-sol plan)
--         Automode behaviour (Opportunity 2017 conjunction anomaly)
--         Post-blackout hold flag (Section 3.3 Constraint 5 / L5)
-- Parameters: power_state — read from PowerModule (never written here)
--
-- FIX LOG:
--   [F-C4]  BLACKOUT no longer nondeterministically enters AUTOMODE.
--           AUTOMODE is triggered only from CONNECTED/DEGRADED on critical power.
--           This ensures BLACKOUT always eventually reaches DEGRADED (C4).
--   [F-L3]  pre_approved_loaded is forced TRUE whenever next step is BLACKOUT,
--           regardless of current state. Covers CONNECTED→DEGRADED→BLACKOUT path.
--   [F-L5]  post_blackout_hold now fires on BLACKOUT→DEGRADED only (the only
--           BLACKOUT exit after removing BLACKOUT→AUTOMODE). NavModule uses this
--           flag to enforce IDLE on the first post-blackout step.
-- =============================================================================

MODULE CommModule(power_state)

VAR
  comm_state          : { CONNECTED, DEGRADED, BLACKOUT, AUTOMODE };
  pre_approved_loaded : boolean;
  blackout_steps      : 0..20;   -- counts steps spent in BLACKOUT (bounds conjunction)
  post_blackout_hold  : boolean; -- TRUE exactly on the first step after BLACKOUT ends (Section 3.3 B5)

ASSIGN

  -- Initial state: connected, no pre-approved sequences loaded yet
  init(comm_state)          := CONNECTED;
  init(pre_approved_loaded) := FALSE;
  init(blackout_steps)      := 0;
  init(post_blackout_hold)  := FALSE;

  -- Communication state transitions
  -- [F-C4] BLACKOUT only exits to DEGRADED (after nondeterministic duration).
  --        AUTOMODE is only triggered from CONNECTED or DEGRADED on critical power.
  --        This guarantees C4: BLACKOUT always eventually reaches DEGRADED.
  next(comm_state) :=
    case
      -- CONNECTED: normal ops. Critical power forces AUTOMODE.
      comm_state = CONNECTED  & power_state = CRITICAL  : AUTOMODE;
      comm_state = CONNECTED  & power_state != CRITICAL : { CONNECTED, DEGRADED };

      -- DEGRADED: weakening signal. Critical power forces AUTOMODE.
      comm_state = DEGRADED   & power_state = CRITICAL  : AUTOMODE;
      comm_state = DEGRADED   & power_state != CRITICAL : { DEGRADED, BLACKOUT, CONNECTED };

      -- BLACKOUT: exits ONLY to DEGRADED after bounded duration. [F-C4]
      -- AUTOMODE is NOT triggered from BLACKOUT — anomaly during blackout
      -- is handled by NavModule entering SAFE_MODE via power/comm checks.
      comm_state = BLACKOUT   & blackout_steps >= 18    : DEGRADED;
      comm_state = BLACKOUT   & blackout_steps < 18     : { BLACKOUT, DEGRADED };

      -- AUTOMODE: self-preservation hold. Exits only to DEGRADED when safe.
      comm_state = AUTOMODE   & power_state != CRITICAL : { AUTOMODE, DEGRADED };
      comm_state = AUTOMODE   & power_state = CRITICAL  : AUTOMODE;

      TRUE : comm_state;
    esac;

  -- pre_approved_loaded:
  -- [F-L3] Force TRUE whenever next step will be BLACKOUT, regardless of
  --        current comm_state. This ensures L3 holds: X(BLACKOUT) → pre_approved=TRUE now.
  --        Also persists through BLACKOUT and clears after AUTOMODE exits.
  next(pre_approved_loaded) :=
    case
      -- Force upload before entering BLACKOUT (covers all paths into BLACKOUT) [F-L3]
      next(comm_state) = BLACKOUT                            : TRUE;
      -- Persists through BLACKOUT
      comm_state = BLACKOUT                                  : pre_approved_loaded;
      -- Clears on re-connection after automode (fresh conjunction cycle)
      comm_state = AUTOMODE & next(comm_state) = DEGRADED   : FALSE;
      -- Normal nondeterministic upload during CONNECTED/DEGRADED
      comm_state = CONNECTED                                 : { TRUE, FALSE };
      comm_state = DEGRADED                                  : { TRUE, FALSE };
      TRUE                                                   : pre_approved_loaded;
    esac;

  -- blackout_steps: counts steps in BLACKOUT, bounds conjunction duration
  next(blackout_steps) :=
    case
      next(comm_state) = BLACKOUT & blackout_steps < 20 : blackout_steps + 1;
      next(comm_state) != BLACKOUT                      : 0;
      TRUE                                              : blackout_steps;
    esac;

  -- post_blackout_hold: TRUE exactly on the first step after BLACKOUT exits to DEGRADED.
  -- [F-L5] With BLACKOUT only exiting to DEGRADED, this fires reliably.
  -- NavModule reads this flag and holds nav_state = IDLE when it is TRUE.
  next(post_blackout_hold) :=
    case
      comm_state = BLACKOUT & next(comm_state) = DEGRADED : TRUE;
      TRUE                                                 : FALSE;
    esac;

-- Fairness: blackout must not last forever (orbital mechanics bound)
FAIRNESS comm_state != BLACKOUT
-- Fairness: AUTOMODE must not persist forever (power eventually recovers)
FAIRNESS comm_state != AUTOMODE
