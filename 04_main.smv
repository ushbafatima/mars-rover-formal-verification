-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 04_main.smv
-- MODULE: main
-- Wires PowerModule, CommModule, and NavModule together.
-- PowerModule feeds power_state and power_fault_active to the others.
-- CommModule receives power_state; produces comm_state, pre_approved_loaded,
--   post_blackout_hold for NavModule.
-- NavModule receives all shared read-only signals; owns navigation FSM.
-- =============================================================================

MODULE main

VAR
  power : PowerModule;
  comm  : CommModule(power.power_state);
  nav   : NavModule(power.power_state, comm.comm_state, comm.pre_approved_loaded,
                    power.power_fault_active, comm.post_blackout_hold);
