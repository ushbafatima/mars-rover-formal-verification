-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 01_power.smv
-- MODULE: PowerModule
-- Owns: power_state, power_fault_active
-- Models: Curiosity fault protection engine (1000+ monitors, 39 responses)
--         Opportunity 22 Wh critical threshold
--         RTG + lithium-ion gradual degradation (no NOMINAL→CRITICAL jump)
-- =============================================================================

MODULE PowerModule

VAR
  power_state      : { NOMINAL, LOW, CRITICAL };
  power_fault_active : boolean;

ASSIGN

  -- Initial state: full power, no fault
  init(power_state)        := NOMINAL;
  init(power_fault_active) := FALSE;

  -- Power degrades nondeterministically but NEVER jumps NOMINAL→CRITICAL in one step
  -- (L2 enforces this; transitions also explicitly prevent it)
  -- Recovery: can only improve one level per step (models battery charge rate limit)
  next(power_state) :=
    case
      power_state = NOMINAL  : { NOMINAL, LOW };           -- can stay or worsen one step
      power_state = LOW      : { LOW, CRITICAL, NOMINAL }; -- can recover, stay, or worsen
      power_state = CRITICAL : { CRITICAL, LOW };          -- can only recover one level
    esac;

  -- Fault protection engine activates when power reaches LOW or CRITICAL
  -- Clears only when power returns to NOMINAL (full health check)
  next(power_fault_active) :=
    case
      next(power_state) = NOMINAL  : FALSE;
      next(power_state) = LOW      : TRUE;
      next(power_state) = CRITICAL : TRUE;
    esac;

-- Fairness: power must not stay CRITICAL forever
-- (models RTG eventually recharging batteries — Opportunity autonomous wake-up)
FAIRNESS power_state != CRITICAL


-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 02_comm.smv
-- MODULE: CommModule
-- Owns: comm_state, pre_approved_loaded, blackout_steps, post_blackout_hold
-- Models: Solar conjunction blackout (~13-18 days → nondeterministic 1..18 steps)
--         Pre-approved command sequence protocol (Curiosity 2023: 18-sol plan)
--         Automode behaviour (Opportunity 2017 conjunction anomaly)
--         Post-blackout hold flag (Section 3.3 Constraint 5 / L5)
-- Parameters: power_state — read from PowerModule (never written here)
-- =============================================================================

MODULE CommModule(power_state)

VAR
  comm_state          : { CONNECTED, DEGRADED, BLACKOUT, AUTOMODE };
  pre_approved_loaded : boolean;
  blackout_steps      : 0..20;   -- counts steps spent in BLACKOUT (bounds conjunction)
  post_blackout_hold  : boolean; -- TRUE exactly on the first step after BLACKOUT ends (Section 3.3 B5)

ASSIGN

  -- Initial state: connected, no pre-approved sequences loaded yet
  init(comm_state)          := CONNECTED;
  init(pre_approved_loaded) := FALSE;
  init(blackout_steps)      := 0;
  init(post_blackout_hold)  := FALSE;

  -- Communication state transitions
  -- Key constraints from spec Section 3.2:
  --   • Critical power → cannot be CONNECTED (no transmitter power)
  --   • BLACKOUT exits when blackout_steps reaches its nondeterministic limit
  --   • AUTOMODE triggered during BLACKOUT by nondeterministic anomaly
  next(comm_state) :=
    case
      -- CONNECTED: normal ops. Can degrade as conjunction approaches.
      -- Critical power forces immediate loss of connection.
      comm_state = CONNECTED  & power_state = CRITICAL  : AUTOMODE;
      comm_state = CONNECTED  & power_state != CRITICAL : { CONNECTED, DEGRADED };

      -- DEGRADED: weakening signal. Proceeds to BLACKOUT or recovers.
      -- Critical power here also forces AUTOMODE (no transmitter power).
      comm_state = DEGRADED   & power_state = CRITICAL  : AUTOMODE;
      comm_state = DEGRADED   & power_state != CRITICAL : { DEGRADED, BLACKOUT, CONNECTED };

      -- BLACKOUT: full moratorium. Only pre-loaded sequences may run.
      -- After nondeterministic duration (blackout_steps hits max), exits to DEGRADED.
      -- Nondeterministic anomaly during blackout → AUTOMODE (Opportunity 2017).
      comm_state = BLACKOUT   & blackout_steps >= 18    : DEGRADED;
      comm_state = BLACKOUT   & blackout_steps < 18     : { BLACKOUT, AUTOMODE };

      -- AUTOMODE: self-preservation hold. Exits only to DEGRADED when safe.
      -- Cannot return to CONNECTED directly — must go through DEGRADED first.
      comm_state = AUTOMODE   & power_state != CRITICAL : { AUTOMODE, DEGRADED };
      comm_state = AUTOMODE   & power_state = CRITICAL  : AUTOMODE;

      TRUE : comm_state;
    esac;

  -- pre_approved_loaded:
  -- Set to TRUE during CONNECTED or DEGRADED (upload window is open).
  -- Once set, persists through BLACKOUT — it is a prior-state dependency.
  -- Cleared only when fully reconnected after blackout (fresh upload window).
  -- This implements Section 3.3 constraint 1: the gate depends on prior state.
  next(pre_approved_loaded) :=
    case
      -- Upload happens before blackout: set during CONNECTED or DEGRADED
      comm_state = CONNECTED                                 : { TRUE, FALSE };
      comm_state = DEGRADED & next(comm_state) = BLACKOUT   : TRUE;  -- must upload before blackout
      comm_state = DEGRADED & next(comm_state) != BLACKOUT  : { TRUE, FALSE };
      -- Persists through BLACKOUT — value frozen from before blackout
      comm_state = BLACKOUT                                  : pre_approved_loaded;
      -- Clears on re-connection (fresh conjunction cycle can start)
      comm_state = AUTOMODE & next(comm_state) = DEGRADED   : FALSE;
      TRUE                                                   : pre_approved_loaded;
    esac;

  -- blackout_steps: counts steps in BLACKOUT, used to bound conjunction duration
  next(blackout_steps) :=
    case
      next(comm_state) = BLACKOUT & blackout_steps < 20 : blackout_steps + 1;
      next(comm_state) != BLACKOUT                      : 0;  -- reset when not in blackout
      TRUE                                              : blackout_steps;
    esac;

  -- post_blackout_hold: TRUE exactly on the first step after BLACKOUT exits.
  -- This is the structural enforcement of Section 3.3 Constraint 5 (B5) / L5.
  -- It is TRUE when: current step is still BLACKOUT AND next step is not BLACKOUT.
  -- NavModule reads this flag and holds in IDLE when it is TRUE.
  next(post_blackout_hold) :=
    case
      comm_state = BLACKOUT & next(comm_state) != BLACKOUT : TRUE;  -- blackout just ended
      TRUE                                                  : FALSE; -- only holds for one step
    esac;

-- Fairness: blackout must not last forever
-- (orbital mechanics guarantee conjunction ends — bounded by blackout_steps >= 18)
FAIRNESS comm_state != BLACKOUT


-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 03_nav.smv
-- MODULE: NavModule
-- Owns: nav_state, obstacle_detected, path_found, terrain_mapped
-- Models: AutoNav / ENav FSM (Perseverance Enhanced Navigation)
--         Curiosity fault protection safe mode
--         All 5 blackout behavioural constraints from Section 3.3
-- Parameters: power_state, comm_state, pre_approved_loaded,
--             power_fault_active, post_blackout_hold — read only
-- =============================================================================

MODULE NavModule(power_state, comm_state, pre_approved_loaded, power_fault_active, post_blackout_hold)

VAR
  nav_state         : { IDLE, DRIVING, AUTONAV, OBSTACLE_DETECTED, REPLANNING, SAFE_MODE };
  obstacle_detected : boolean;  -- nondeterministic: stereo camera hazard flag
  path_found        : boolean;  -- nondeterministic: ENav path planner result
  terrain_mapped    : boolean;  -- TRUE when current terrain has been 3D-mapped

ASSIGN

  -- Initial state: parked, no hazards, terrain not yet mapped
  init(nav_state)         := IDLE;
  init(obstacle_detected) := FALSE;
  init(path_found)        := TRUE;
  init(terrain_mapped)    := FALSE;

  -- Navigation FSM transitions
  -- Encodes ALL constraints from Sections 3.2 and 3.3:
  --
  --   Section 3.2:
  --     [I1] CRITICAL power → cannot enter DRIVING or AUTONAV
  --     [I2] BLACKOUT + driving → only if pre_approved_loaded = TRUE
  --     [I3] AUTOMODE → immediately enter SAFE_MODE
  --
  --   Section 3.3 (blackout behavioural constraints):
  --     [B1] BLACKOUT: DRIVING only if pre_approved_loaded (I2 above)
  --     [B2] BLACKOUT: terrain_mapped must be TRUE before any drive step
  --     [B3] BLACKOUT + LOW power: REPLANNING blocked → SAFE_MODE instead
  --     [B4] BLACKOUT + anomaly (AUTOMODE): → SAFE_MODE (I3 above)
  --     [B5] Post-blackout: first step must be IDLE — enforced by post_blackout_hold flag
  --
  --   BUG FIX — power_fault_active (L1):
  --     [F1] power_fault_active=TRUE → IDLE cannot transition to DRIVING/AUTONAV
  --          until SAFE_MODE is reached first (satisfies L1's Until obligation)

  next(nav_state) :=
    case
      -- ── AUTOMODE OVERRIDE (Section 3.2 [I3], Section 3.3 [B4]) ──────────
      -- Highest priority: AUTOMODE forces SAFE_MODE regardless of nav state
      comm_state = AUTOMODE
        : SAFE_MODE;

      -- ── SAFE_MODE ─────────────────────────────────────────────────────────
      -- Exit safe mode only when: power fully recovered (NOMINAL = fault cleared),
      -- not in blackout or automode.
      -- NOTE: power_state = NOMINAL is semantically equivalent to !power_fault_active
      --       (power_fault_active is TRUE iff power_state != NOMINAL per PowerModule).
      nav_state = SAFE_MODE & power_state = NOMINAL & comm_state != BLACKOUT
        & comm_state != AUTOMODE
        : IDLE;
      nav_state = SAFE_MODE
        : SAFE_MODE;

      -- ── IDLE ──────────────────────────────────────────────────────────────

      -- [B5] Post-blackout hold: first step after blackout must stay IDLE.
      -- post_blackout_hold is TRUE exactly on the one step when BLACKOUT just ended.
      -- This is the structural enforcement that makes L5 hold.
      nav_state = IDLE & post_blackout_hold
        : IDLE;

      -- Cannot drive: critical power (C1 / [I1])
      nav_state = IDLE & power_state = CRITICAL
        : IDLE;

      -- [FIX — L1] Cannot start driving when power fault is active (power=LOW or CRITICAL).
      -- L1 requires: fault_active → !DRIVING U SAFE_MODE.
      -- Rover must pass through SAFE_MODE before driving is permitted again.
      -- Without this block, IDLE→DRIVING was possible while fault_active=TRUE, falsifying L1.
      nav_state = IDLE & power_fault_active
        : IDLE;

      -- Cannot drive: in BLACKOUT without pre-approval or terrain not mapped
      nav_state = IDLE & comm_state = BLACKOUT
        & (!pre_approved_loaded | !terrain_mapped)
        : IDLE;

      -- Normal idle → can start driving or autonav (terrain must be mapped)
      -- terrain_mapped is set to TRUE during IDLE (mapping phase before drive)
      nav_state = IDLE & power_state != CRITICAL & !power_fault_active
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & terrain_mapped
        : { DRIVING, AUTONAV };

      -- Idle with terrain not yet mapped: stay idle and map
      nav_state = IDLE & power_state != CRITICAL & !power_fault_active
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & !terrain_mapped
        : IDLE;

      -- BLACKOUT + pre-approved + terrain mapped → can drive on pre-loaded plan only
      nav_state = IDLE & comm_state = BLACKOUT
        & pre_approved_loaded & terrain_mapped
        & power_state != CRITICAL & !power_fault_active
        : { IDLE, DRIVING };

      -- ── DRIVING ───────────────────────────────────────────────────────────
      -- Obstacle encountered (nondeterministic) → OBSTACLE_DETECTED
      nav_state = DRIVING & obstacle_detected
        : OBSTACLE_DETECTED;

      -- Critical power while driving → SAFE_MODE immediately
      nav_state = DRIVING & power_state = CRITICAL
        : SAFE_MODE;

      -- AUTOMODE during drive → already handled by top priority case above

      -- Blackout: driving with pre-approval and terrain mapped → continue or finish
      nav_state = DRIVING & comm_state = BLACKOUT & pre_approved_loaded & terrain_mapped
        & power_state != CRITICAL & !obstacle_detected
        : { DRIVING, IDLE };

      -- Blackout: driving but pre-approval or terrain condition violated → SAFE_MODE
      nav_state = DRIVING & comm_state = BLACKOUT
        & (!pre_approved_loaded | !terrain_mapped)
        : SAFE_MODE;

      -- Normal driving: can continue or finish (go IDLE)
      nav_state = DRIVING & comm_state != BLACKOUT & comm_state != AUTOMODE
        & power_state != CRITICAL & !obstacle_detected
        : { DRIVING, IDLE };

      -- ── AUTONAV ───────────────────────────────────────────────────────────
      -- ENav "thinking while driving" mode — more autonomous than DRIVING
      -- Same constraints as DRIVING but restricted during BLACKOUT (no new exploration)
      nav_state = AUTONAV & obstacle_detected
        : OBSTACLE_DETECTED;

      nav_state = AUTONAV & power_state = CRITICAL
        : SAFE_MODE;

      -- AUTONAV blocked during BLACKOUT: Section 3.3 [B2] no new terrain exploration
      nav_state = AUTONAV & comm_state = BLACKOUT
        : SAFE_MODE;

      nav_state = AUTONAV & comm_state != BLACKOUT & comm_state != AUTOMODE
        & power_state != CRITICAL & !obstacle_detected
        : { AUTONAV, IDLE };

      -- ── OBSTACLE_DETECTED ─────────────────────────────────────────────────
      -- ENav two-stage: always proceeds to REPLANNING or SAFE_MODE (never stuck)
      -- Section 3.3 [B3]: BLACKOUT + LOW power → REPLANNING blocked → SAFE_MODE
      nav_state = OBSTACLE_DETECTED & comm_state = BLACKOUT & power_state = LOW
        : SAFE_MODE;

      nav_state = OBSTACLE_DETECTED & power_state = CRITICAL
        : SAFE_MODE;

      nav_state = OBSTACLE_DETECTED & comm_state = AUTOMODE
        : SAFE_MODE;

      -- Normal: proceed to replanning
      nav_state = OBSTACLE_DETECTED
        : REPLANNING;

      -- ── REPLANNING ────────────────────────────────────────────────────────
      -- ENav path planner result is nondeterministic (path_found: TRUE/FALSE)
      -- If path found → resume drive; if not → SAFE_MODE
      -- Section 3.3 [B3]: BLACKOUT + LOW power → SAFE_MODE (no replanning)
      nav_state = REPLANNING & power_state = CRITICAL
        : SAFE_MODE;

      nav_state = REPLANNING & comm_state = AUTOMODE
        : SAFE_MODE;

      -- Path found → resume appropriate drive mode
      nav_state = REPLANNING & path_found & power_state != CRITICAL
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        : { DRIVING, AUTONAV };

      -- Path not found → safe mode
      nav_state = REPLANNING & !path_found
        : SAFE_MODE;

      -- BLACKOUT during replanning: only continue if pre-approved and non-critical power
      nav_state = REPLANNING & comm_state = BLACKOUT
        & pre_approved_loaded & power_state != CRITICAL & path_found
        : { DRIVING, SAFE_MODE };

      nav_state = REPLANNING & comm_state = BLACKOUT
        & (!pre_approved_loaded | power_state = LOW)
        : SAFE_MODE;

      TRUE : nav_state;
    esac;

  -- obstacle_detected: nondeterministic hazard flag (stereo camera)
  -- Can appear during DRIVING or AUTONAV; clears when not moving
  next(obstacle_detected) :=
    case
      nav_state = DRIVING | nav_state = AUTONAV : { TRUE, FALSE };
      TRUE                                       : FALSE;
    esac;

  -- path_found: ENav path planner result — nondeterministic
  -- Only meaningful when in REPLANNING; nondeterministic elsewhere
  next(path_found) :=
    case
      nav_state = REPLANNING : { TRUE, FALSE };
      TRUE                   : { TRUE, FALSE };
    esac;

  -- terrain_mapped: becomes TRUE during IDLE (mapping phase)
  -- Persists as TRUE once mapped (ENav continuously updates)
  -- Resets to FALSE after SAFE_MODE (terrain re-verification required)
  next(terrain_mapped) :=
    case
      nav_state = IDLE & power_state != CRITICAL : TRUE;   -- mapping during idle
      nav_state = SAFE_MODE                      : FALSE;  -- reset after fault
      TRUE                                       : terrain_mapped;
    esac;

-- Fairness constraints:
-- Without these, NuSMV could find infinite paths where the system
-- stays in OBSTACLE_DETECTED or REPLANNING forever (violating C3 liveness).
-- These fairness constraints say: the system must not perpetually avoid progress.
FAIRNESS nav_state != OBSTACLE_DETECTED
FAIRNESS nav_state != REPLANNING
FAIRNESS !(power_state = CRITICAL & comm_state = BLACKOUT)


-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 04_main.smv
-- MODULE: main
-- Wires PowerModule, CommModule, and NavModule together.
-- PowerModule feeds power_state and power_fault_active to the others.
-- CommModule receives power_state; produces comm_state, pre_approved_loaded,
--   post_blackout_hold for NavModule.
-- NavModule receives all shared read-only signals; owns navigation FSM.
-- =============================================================================

MODULE main

VAR
  power : PowerModule;
  comm  : CommModule(power.power_state);
  nav   : NavModule(power.power_state, comm.comm_state, comm.pre_approved_loaded,
                    power.power_fault_active, comm.post_blackout_hold);


-- =============================================================================
-- FORMAL METHODS — SE-320  |  BESE-14B  |  Group 01
-- FILE: 05_properties.smv
-- All 11 formal properties: C1–C6 (CTL via SPEC) + L1–L5 (LTL via LTLSPEC)
--
-- CTL  (SPEC)   — branching-time: AG/AF over the full computation tree.
--                 Used for state invariants and branching liveness.
-- LTL  (LTLSPEC)— linear-time: G/X/U over individual execution paths.
--                 Used for sequencing, transition constraints, protocol ordering.
-- Both logics are incomparable in expressive power; using both gives strictly
-- more complete verification than either alone.
-- =============================================================================


-- -----------------------------------------------------------------------------
-- CTL PROPERTIES  (SPEC keyword)
-- Verified using symbolic model checking over the computation tree
-- -----------------------------------------------------------------------------

-- C1: Power Gate on Locomotion (Safety)
-- Critical power → rover is never DRIVING or AUTONAV
-- Cross-module invariant: PowerModule state gates NavModule transitions
-- NASA basis: Curiosity fault engine; Opportunity 22 Wh shutdown
SPEC AG(
  power.power_state = CRITICAL ->
  nav.nav_state != DRIVING & nav.nav_state != AUTONAV
)

-- C2: Blackout Command Gate (Safety)
-- During BLACKOUT, any driving requires pre-approved commands loaded
-- NASA basis: Curiosity 2023 conjunction; Opportunity moratorium
SPEC AG(
  comm.comm_state = BLACKOUT & nav.nav_state = DRIVING ->
  comm.pre_approved_loaded = TRUE
)

-- C3a: Obstacle Detection Eventually Resolved — Part 1 (Liveness)
-- Obstacle detection always leads to REPLANNING or SAFE_MODE (never a deadlock)
-- NASA basis: ENav path planner always terminates
SPEC AG(
  nav.nav_state = OBSTACLE_DETECTED ->
  AF(nav.nav_state = REPLANNING | nav.nav_state = SAFE_MODE)
)

-- C3b: Obstacle Detection Eventually Resolved — Part 2 (Liveness)
-- Replanning always terminates: either resumes drive or enters safe mode
-- NASA basis: ENav two-stage decision: path found or stop
SPEC AG(
  nav.nav_state = REPLANNING ->
  AF(nav.nav_state = DRIVING | nav.nav_state = AUTONAV | nav.nav_state = SAFE_MODE)
)

-- C4: Conjunction Always Ends (Liveness)
-- BLACKOUT always eventually transitions to DEGRADED or CONNECTED
-- blackout_steps counter bounds this to max 18 steps
-- NASA basis: orbital mechanics — conjunction bounded ~18 days
SPEC AG(
  comm.comm_state = BLACKOUT ->
  AF(comm.comm_state = DEGRADED | comm.comm_state = CONNECTED)
)

-- C5: Full Conjunction Safety Protocol (Composite Safety)
-- All three conditions must hold simultaneously during any blackout movement
-- Strongest safety property: catches violations of any individual constraint
-- NASA basis: full conjunction protocol across all 3 modules
SPEC AG(
  comm.comm_state = BLACKOUT &
  (nav.nav_state = DRIVING | nav.nav_state = AUTONAV) ->
  nav.terrain_mapped = TRUE &
  power.power_state != CRITICAL &
  comm.pre_approved_loaded = TRUE
)

-- C6: Autonomous Power Recovery During Blackout (Liveness)
-- Critical power during blackout → eventually recovers autonomously
-- NASA basis: Opportunity clock-based autonomous battery wake-up protocol
SPEC AG(
  power.power_state = CRITICAL & comm.comm_state = BLACKOUT ->
  AF(power.power_state = LOW | power.power_state = NOMINAL)
)


-- -----------------------------------------------------------------------------
-- LTL PROPERTIES  (LTLSPEC keyword)
-- Verified using bounded/unbounded LTL model checking over linear paths
-- NuSMV produces lasso-shaped counterexamples (prefix + loop) for LTL violations
-- -----------------------------------------------------------------------------

-- L1: Safe Mode Must Precede Drive Resumption After Fault (Until — Sequencing)
-- Once a power fault is active, the rover must NOT drive until SAFE_MODE is reached
-- Uses Until (U) — expressible only in LTL, not CTL
-- NASA basis: Curiosity — safe mode required hold before any resumption
LTLSPEC G(
  power.power_fault_active ->
  (nav.nav_state != DRIVING) U (nav.nav_state = SAFE_MODE)
)

-- L2: No Power Jump from NOMINAL to CRITICAL in One Step (Next — Transition)
-- Power must degrade gradually: NOMINAL → LOW → CRITICAL
-- Uses X (Next) — expressible only in LTL, not CTL
-- NASA basis: RTG + battery chemistry; gradual degradation only
LTLSPEC G(
  power.power_state = NOMINAL -> X(power.power_state != CRITICAL)
)

-- L3: Pre-Approved Commands Loaded Before Blackout Entry (Next — Pre-condition)
-- If the next step is BLACKOUT, pre_approved_loaded must be TRUE right now
-- Stronger than C2: catches failure to pre-load even if rover never drives
-- NASA basis: Perseverance 2021 — upload closes at blackout entry
LTLSPEC G(
  X(comm.comm_state = BLACKOUT) -> comm.pre_approved_loaded = TRUE
)

-- L4: AUTOMODE Enforces Minimum One-Step Non-Driving Hold (Next — Hold State)
-- When AUTOMODE is active, the rover cannot be driving at the very next step
-- Catches zero-duration passthrough AUTOMODE implementations
-- NASA basis: Opportunity 2017 — automode sustained, not passthrough
LTLSPEC G(
  comm.comm_state = AUTOMODE ->
  X(nav.nav_state != DRIVING & nav.nav_state != AUTONAV)
)

-- L5: Post-Blackout First Step Must Be IDLE (Transition Ordering)
-- Directly verifies Section 3.3 Constraint 5: post-blackout delay
-- When blackout ends (this step = BLACKOUT, next step != BLACKOUT),
-- the rover must be in IDLE at that first post-blackout step
-- NASA basis: post-conjunction hold documented in Space.com Nov 2023 report
LTLSPEC G(
  comm.comm_state = BLACKOUT & X(comm.comm_state != BLACKOUT) ->
  X(nav.nav_state = IDLE)
)

