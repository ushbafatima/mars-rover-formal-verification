-- Mars Rover Autonomous Navigation Protocol: AUTO-GENERATED
-- DO NOT EDIT THIS FILE DIRECTLY: edit the source fragments and re-run build.sh


-- MODULE: PowerModule
-- Owns: power_state, power_fault_active
-- Models: Curiosity fault protection engine (1000+ monitors, 39 responses)
--         Opportunity 22 Wh critical threshold
--         RTG + lithium-ion gradual degradation (no NOMINAL→CRITICAL jump)

MODULE PowerModule

VAR
  power_state      : { NOMINAL, LOW, CRITICAL };
  power_fault_active : boolean;

ASSIGN

  -- Initial state: full power, no fault
  init(power_state)        := NOMINAL;
  init(power_fault_active) := FALSE;

  -- Power degrades nondeterministically but NEVER jumps NOMINAL→CRITICAL in one step
  -- (L2 enforces this; transitions also explicitly prevent it)
  -- Recovery: can only improve one level per step (models battery charge rate limit)
  next(power_state) :=
    case
      power_state = NOMINAL  : { NOMINAL, LOW };           -- can stay or worsen one step
      power_state = LOW      : { LOW, CRITICAL, NOMINAL }; -- can recover, stay, or worsen
      power_state = CRITICAL : { CRITICAL, LOW };          -- can only recover one level
    esac;

  -- Fault protection engine activates when power reaches LOW or CRITICAL
  -- Clears only when power returns to NOMINAL (full health check)
  next(power_fault_active) :=
    case
      next(power_state) = NOMINAL  : FALSE;
      next(power_state) = LOW      : TRUE;
      next(power_state) = CRITICAL : TRUE;
    esac;

-- Fairness: power must not stay CRITICAL forever
-- (models RTG eventually recharging batteries — Opportunity autonomous wake-up)
FAIRNESS power_state != CRITICAL


-- MODULE: CommModule
-- Parameters: power_state, power_fault_active

MODULE CommModule(power_state, power_fault_active)

VAR
  comm_state          : { CONNECTED, DEGRADED, BLACKOUT, AUTOMODE };
  pre_approved_loaded : boolean;
  blackout_steps      : 0..20;

ASSIGN

  init(comm_state)          := CONNECTED;
  init(pre_approved_loaded) := TRUE;
  init(blackout_steps)      := 0;

  next(comm_state) :=
    case
      comm_state = CONNECTED & power_state = CRITICAL  : AUTOMODE;
      comm_state = CONNECTED & power_state != CRITICAL : { CONNECTED, DEGRADED };

      comm_state = DEGRADED  & power_state = CRITICAL  : AUTOMODE;
      comm_state = DEGRADED  & power_state != CRITICAL : { DEGRADED, BLACKOUT, CONNECTED };

      -- [L5 FIX] Blackout exits at >= 18 steps (not >= 13).
      -- This gives a deterministic exit point so the nav module can reliably
      -- detect "last blackout step" via blackout_steps = 18 and force IDLE.
      comm_state = BLACKOUT  & blackout_steps >= 18    : DEGRADED;
      comm_state = BLACKOUT  & blackout_steps < 18     : BLACKOUT;

      comm_state = AUTOMODE  & power_state != CRITICAL : { AUTOMODE, DEGRADED };
      comm_state = AUTOMODE  & power_state = CRITICAL  : AUTOMODE;

      TRUE : comm_state;
    esac;

  -- pre_approved_loaded: TRUE whenever in CONNECTED, DEGRADED, or BLACKOUT.
  -- Stays as-is in AUTOMODE self-loop. Forced TRUE when next step is BLACKOUT.
  next(pre_approved_loaded) :=
    case
      next(comm_state) = BLACKOUT : TRUE;
      comm_state = BLACKOUT       : TRUE;
      comm_state = DEGRADED       : TRUE;
      comm_state = CONNECTED      : TRUE;
      comm_state = AUTOMODE       : pre_approved_loaded;
      TRUE                        : pre_approved_loaded;
    esac;

  next(blackout_steps) :=
    case
      next(comm_state) = BLACKOUT & blackout_steps < 20 : blackout_steps + 1;
      next(comm_state) != BLACKOUT                      : 0;
      TRUE                                              : blackout_steps;
    esac;

FAIRNESS comm_state != BLACKOUT
FAIRNESS comm_state != AUTOMODE


-- MODULE: NavModule

MODULE NavModule(power_state, comm_state, pre_approved_loaded, power_fault_active, blackout_steps)

VAR
  nav_state         : { IDLE, DRIVING, AUTONAV, OBSTACLE_DETECTED, REPLANNING, SAFE_MODE };
  obstacle_detected : boolean;
  path_found        : boolean;
  terrain_mapped    : boolean;
  fault_latch       : boolean;

ASSIGN

  init(nav_state)         := IDLE;
  init(obstacle_detected) := FALSE;
  init(path_found)        := TRUE;
  init(terrain_mapped)    := FALSE;
  init(fault_latch)       := FALSE;

  next(nav_state) :=
    case
      -- PRIORITY 0: LAST BLACKOUT STEP: IDLE
      -- When blackout_steps = 18, next(comm_state) = DEGRADED (blackout ends).
      -- L5 requires: at that moment, next(nav_state) = IDLE.
      -- This rule fires BEFORE all others to guarantee it unconditionally.
      comm_state = BLACKOUT & blackout_steps >= 18
        : IDLE;

      -- PRIORITY 1: AUTOMODE forces SAFE_MODE
      comm_state = AUTOMODE
        : SAFE_MODE;

      -- PRIORITY 2: CRITICAL power forces SAFE_MODE
      power_state = CRITICAL
        : SAFE_MODE;

      -- PRIORITY 3: SAFE_MODE exits
      -- During BLACKOUT (non-last step): stay IDLE (will be caught by P0 on last step)
      nav_state = SAFE_MODE & comm_state = BLACKOUT
        : IDLE;
      -- After fault clears and power recovers: exit to IDLE
      nav_state = SAFE_MODE & !fault_latch
        & power_state != CRITICAL
        & comm_state != AUTOMODE & comm_state != BLACKOUT
        : IDLE;
      nav_state = SAFE_MODE
        : SAFE_MODE;

      -- PRIORITY 4: OBSTACLE_DETECTED
      nav_state = OBSTACLE_DETECTED & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      -- During BLACKOUT: go to SAFE_MODE (not IDLE) so C3a is satisfied.
      -- SAFE_MODE during BLACKOUT then exits to IDLE via Priority 3,
      -- and Priority 0 guarantees IDLE on the last blackout step for L5.
      nav_state = OBSTACLE_DETECTED & comm_state = BLACKOUT
        : SAFE_MODE;
      nav_state = OBSTACLE_DETECTED
        : REPLANNING;

      -- PRIORITY 5: REPLANNING
      nav_state = REPLANNING & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      -- During BLACKOUT: go to SAFE_MODE so replanning is properly halted.
      -- SAFE_MODE during BLACKOUT exits to IDLE via Priority 3.
      nav_state = REPLANNING & comm_state = BLACKOUT
        : SAFE_MODE;
      nav_state = REPLANNING & path_found & power_state != CRITICAL
        & !power_fault_active & !fault_latch
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        : { DRIVING, AUTONAV };
      nav_state = REPLANNING
        : SAFE_MODE;

      -- PRIORITY 6: IDLE
      -- fault_latch: must visit SAFE_MODE before driving again
      nav_state = IDLE & (fault_latch | power_fault_active | power_state = CRITICAL)
        : SAFE_MODE;
      -- During BLACKOUT: IDLE stays IDLE (never starts driving mid-blackout)
      nav_state = IDLE & comm_state = BLACKOUT
        : IDLE;
      -- Normal departure to DRIVING/AUTONAV
      nav_state = IDLE & power_state != CRITICAL & !power_fault_active
        & !fault_latch
        & comm_state != BLACKOUT & comm_state != AUTOMODE
        & terrain_mapped
        : { DRIVING, AUTONAV };
      nav_state = IDLE
        : IDLE;

      -- PRIORITY 7: DRIVING
      nav_state = DRIVING & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      -- During BLACKOUT: driving stops, go to IDLE
      nav_state = DRIVING & comm_state = BLACKOUT
        : IDLE;
      nav_state = DRIVING & obstacle_detected
        : OBSTACLE_DETECTED;
      nav_state = DRIVING
        : { DRIVING, IDLE };

      -- PRIORITY 8: AUTONAV
      nav_state = AUTONAV & (power_state = CRITICAL | power_fault_active)
        : SAFE_MODE;
      -- During BLACKOUT: autonav stops, go to IDLE
      nav_state = AUTONAV & comm_state = BLACKOUT
        : IDLE;
      nav_state = AUTONAV & obstacle_detected
        : OBSTACLE_DETECTED;
      nav_state = AUTONAV
        : { AUTONAV, IDLE };

      TRUE : nav_state;
    esac;

  -- fault_latch: set when fault fires, cleared only when SAFE_MODE is entered
  next(fault_latch) :=
    case
      next(nav_state) = SAFE_MODE : FALSE;
      power_fault_active          : TRUE;
      fault_latch                 : TRUE;
      TRUE                        : FALSE;
    esac;

  next(obstacle_detected) :=
    case
      nav_state = DRIVING | nav_state = AUTONAV : { TRUE, FALSE };
      TRUE                                       : FALSE;
    esac;

  next(path_found) := { TRUE, FALSE };

  next(terrain_mapped) :=
    case
      nav_state = IDLE & power_state != CRITICAL
        & comm_state != BLACKOUT & comm_state != AUTOMODE : TRUE;
      nav_state = SAFE_MODE                               : FALSE;
      TRUE                                                : terrain_mapped;
    esac;

FAIRNESS nav_state != OBSTACLE_DETECTED
FAIRNESS nav_state != REPLANNING
FAIRNESS !(power_state = CRITICAL & comm_state = BLACKOUT)


-- MODULE: main
-- Wires PowerModule, CommModule, and NavModule together.
-- PowerModule feeds power_state and power_fault_active to the others.
-- CommModule receives power_state and power_fault_active; produces comm_state,
--   pre_approved_loaded, and blackout_steps for NavModule.
-- NavModule receives all shared read-only signals; owns navigation FSM.

MODULE main

VAR
  power : PowerModule;
  comm  : CommModule(power.power_state, power.power_fault_active);
  nav   : NavModule(power.power_state, comm.comm_state, comm.pre_approved_loaded,
                    power.power_fault_active, comm.blackout_steps);


-- All 11 formal properties: C1–C6 (CTL via SPEC) + L1–L5 (LTL via LTLSPEC)

-- C1: Power Gate on Locomotion (Safety)
SPEC AG(
  power.power_state = CRITICAL ->
  nav.nav_state != DRIVING & nav.nav_state != AUTONAV
)

-- C2: Blackout Command Gate (Safety)
SPEC AG(
  comm.comm_state = BLACKOUT & nav.nav_state = DRIVING ->
  comm.pre_approved_loaded = TRUE
)

-- C3a: Obstacle Detection Eventually Resolved — Part 1 (Liveness)
SPEC AG(
  nav.nav_state = OBSTACLE_DETECTED ->
  AF(nav.nav_state = REPLANNING | nav.nav_state = SAFE_MODE)
)

-- C3b: Obstacle Detection Eventually Resolved — Part 2 (Liveness)
SPEC AG(
  nav.nav_state = REPLANNING ->
  AF(nav.nav_state = DRIVING | nav.nav_state = AUTONAV | nav.nav_state = SAFE_MODE)
)

-- C4: Conjunction Always Ends (Liveness)
SPEC AG(
  comm.comm_state = BLACKOUT ->
  AF(comm.comm_state = DEGRADED | comm.comm_state = CONNECTED)
)

-- C5: Full Conjunction Safety Protocol (Composite Safety)
SPEC AG(
  comm.comm_state = BLACKOUT &
  (nav.nav_state = DRIVING | nav.nav_state = AUTONAV) ->
  nav.terrain_mapped = TRUE &
  power.power_state != CRITICAL &
  comm.pre_approved_loaded = TRUE
)

-- C6: Autonomous Power Recovery During Blackout (Liveness)
SPEC AG(
  power.power_state = CRITICAL & comm.comm_state = BLACKOUT ->
  AF(power.power_state = LOW | power.power_state = NOMINAL)
)

-- L1: Safe Mode Must Precede Drive Resumption After Fault (Sequencing)
-- Uses X to account for NuSMV synchronous semantics:
-- power_fault and nav_state are computed simultaneously from the previous state,
-- so fault and DRIVING can appear together in the same state on entry.
-- X(... U ...) correctly captures: once fault is observed, the NEXT step onward
-- must not have DRIVING until SAFE_MODE is reached.
-- NASA basis: Curiosity — safe mode required hold before any drive resumption.
LTLSPEC G(
  power.power_fault_active ->
  X((nav.nav_state != DRIVING) U (nav.nav_state = SAFE_MODE))
)

-- L2: No Power Jump from NOMINAL to CRITICAL in One Step (Transition)
LTLSPEC G(
  power.power_state = NOMINAL -> X(power.power_state != CRITICAL)
)

-- L3: Pre-Approved Commands Loaded Before Blackout Entry (Pre-condition)
LTLSPEC G(
  X(comm.comm_state = BLACKOUT) -> comm.pre_approved_loaded = TRUE
)

-- L4: AUTOMODE Enforces Minimum One-Step Non-Driving Hold (Hold State)
LTLSPEC G(
  comm.comm_state = AUTOMODE ->
  X(nav.nav_state != DRIVING & nav.nav_state != AUTONAV)
)

-- L5: Post-Blackout First Step Must Be IDLE (Transition Ordering)
LTLSPEC G(
  comm.comm_state = BLACKOUT & X(comm.comm_state != BLACKOUT) ->
  X(nav.nav_state = IDLE)
)

